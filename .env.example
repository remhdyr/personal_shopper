# Gemini is required by the default AI configuration.
# Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional second AI provider (DashScope/Qwen); leave blank to use Gemini only.
QWEN_API_KEY=

# Optional Telegram alerts; both values are required to enable them.
# Create a bot with @BotFather, then set its token and your target chat ID.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional eBay Browse API credentials; both are required to enable eBay.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production

# Optional Tradera API credentials; both are required to enable Tradera.
TRADERA_APP_ID=
TRADERA_APP_KEY=

# Optional Blocket token; public search works without one.
BLOCKET_TOKEN=